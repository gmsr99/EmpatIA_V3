# Google Cloud / Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=vertex-key.json
GOOGLE_CLOUD_PROJECT=empatia-480916
GOOGLE_CLOUD_REGION=europe-southwest1

# PostgreSQL Database (VPS)
POSTGRES_HOST=72.60.89.5
POSTGRES_PORT=5433
POSTGRES_DB=bd_vet_empatia3
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# WebSocket Server
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765

# Gemini Model Configuration (legacy)
GEMINI_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_VOICE=Kore
GEMINI_LANGUAGE=pt-PT
GEMINI_TEMPERATURE=0.6

# Groq STT (Whisper)
GROQ_API_KEY=gsk_your_key_here
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=pt

# Gemini LLM (text reasoning)
GEMINI_LLM_MODEL=gemini-2.5-flash-lite

# Google Cloud TTS (WaveNet)
TTS_VOICE_NAME=pt-PT-Wavenet-D
TTS_SAMPLE_RATE=24000
TTS_SPEAKING_RATE=0.9

# Report generation
GEMINI_REPORT_MODEL=gemini-2.0-flash

# VAD (Voice Activity Detection)
VAD_SILENCE_THRESHOLD=0.01
VAD_SILENCE_DURATION_MS=1500
VAD_MIN_SPEECH_DURATION_MS=300

# Logging
LOG_LEVEL=INFO
